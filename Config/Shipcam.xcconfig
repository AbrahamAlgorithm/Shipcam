// Build settings for the Shipcam app target that can differ per developer.
//
// Signing defaults to ad-hoc, so anyone, including CI, can build without an Apple
// account. To sign with your own team, which keeps macOS permissions such as Screen
// Recording granted across rebuilds, create Config/Signing.local.xcconfig (gitignored):
//
//     DEVELOPMENT_TEAM = <your Team ID>
//     CODE_SIGN_IDENTITY = Apple Development

CODE_SIGN_STYLE = Automatic
CODE_SIGN_IDENTITY = -

#include? "Signing.local.xcconfig"
